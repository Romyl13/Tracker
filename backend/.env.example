# Copy to .env and adjust for your PostgreSQL instance
DATABASE_URL=postgresql+asyncpg://health_user:health_pass@localhost:5432/health_tracker

# Firebase Admin / token verification (use your Web API key + project for JWKS)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: path to persisted sklearn model (otherwise in-memory demo model is trained)
ML_MODEL_PATH=
